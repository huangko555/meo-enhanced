{
  "targetRoots": [
    "src/foundation",
    "src/domain",
    "src/application",
    "src/protocol",
    "src/host",
    "webview/src/application",
    "webview/src/adapters",
    "webview/src/bootstrap",
    "webview/src/editor"
  ],
  "bootstrapOnlyModules": [
    {
      "module": "webview/src/adapters/mermaidDiagramPresentationRuntime.ts",
      "allowedImporters": ["webview/src/index.ts"]
    },
    {
      "module": "webview/src/editor/mermaidDiagramPresentationAdapter.ts",
      "allowedImporters": ["webview/src/index.ts"]
    },
    {
      "module": "webview/src/editor/mermaidDiagramRenderPool.ts",
      "allowedImporters": ["webview/src/index.ts"]
    }
  ],
  "bootstrapLifecycleContracts": [
    {
      "file": "webview/src/index.ts",
      "constructors": [
        {
          "module": "webview/src/editor/mermaidDiagramRenderPool.ts",
          "export": "createMermaidDiagramRenderPool"
        },
        {
          "module": "webview/src/editor/mermaidDiagramPresentation.ts",
          "export": "createMermaidDiagramPresentationFactory"
        }
      ],
      "disposeOrder": [
        "createMermaidDiagramPresentationFactory",
        "createMermaidDiagramRenderPool"
      ]
    }
  ],
  "resourceOwnerFreeModules": ["webview/src/helpers/mermaidDiagram.ts"],
  "knownLegacyTestFailures": [
    {
      "id": "LEG-TEST-001",
      "test": "scripts/test-mermaid-editing.ts",
      "fingerprint": "Rendered-block history did not preserve mode and focus its changed offset"
    }
  ]
}
